<UserControl x:Class="BlaxtorGym.src.BlaxtorGym.WPF.Views.MembresiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Membresías"
                   FontSize="20"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock Text="Cliente"/>

            <ComboBox ItemsSource="{Binding Clientes}"
                      SelectedItem="{Binding ClienteSeleccionado}"
                      DisplayMemberPath="NombreCompleto"
                      Height="30"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Tipo de membresía"/>

            <ComboBox ItemsSource="{Binding TiposMembresia}"
                      SelectedItem="{Binding TipoMembresiaSeleccionado}"
                      DisplayMemberPath="Nombre"
                      Height="30"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Fecha de inicio"/>

            <DatePicker SelectedDate="{Binding FechaInicio,
                                               UpdateSourceTrigger=PropertyChanged}"
                        Height="30"
                        Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">

                <Button Content="Crear membresía"
                        Width="130"
                        Height="30"
                        Margin="0,0,10,0"
                        Command="{Binding CrearCommand}"/>

                <Button Content="Renovar"
                        Width="100"
                        Height="30"
                        Margin="0,0,10,0"
                        Command="{Binding RenovarCommand}"/>

                <Button Content="Desactivar"
                        Width="100"
                        Height="30"
                        Margin="0,0,10,0"
                        Command="{Binding DesactivarCommand}"/>

                <Button Content="Limpiar"
                        Width="100"
                        Height="30"
                        Command="{Binding LimpiarCommand}"/>

            </StackPanel>

        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Membresias}"
                  SelectedItem="{Binding MembresiaSeleccionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding Cliente.NombreCompleto}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Membresía"
                                    Binding="{Binding TipoMembresia.Nombre}"
                                    Width="*"/>

                <DataGridTextColumn Header="Fecha inicio"
                                    Binding="{Binding FechaInicio}"
                                    Width="130"/>

                <DataGridTextColumn Header="Vencimiento"
                                    Binding="{Binding FechaVencimiento}"
                                    Width="130"/>

                <DataGridTextColumn Header="Precio aplicado"
                                    Binding="{Binding PrecioAplicado}"
                                    Width="120"/>

                <DataGridTextColumn Header="Estado"
                    Binding="{Binding Estado}"
                    Width="100"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>