<Window x:Class="BlaxtorGym.src.BlaxtorGym.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlaxtorGym - Inicio de sesión"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#090909"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <SolidColorBrush x:Key="RosaPrincipal"
                         Color="#FFFF5C9E"/>

        <SolidColorBrush x:Key="GrisPlaceholder"
                         Color="#FFA8A8A8"/>

        <!-- ========================================= -->
        <!-- TEXTBOX -->
        <!-- ========================================= -->

        <Style x:Key="LoginTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#EE1B1B1B"/>

            <Setter Property="BorderBrush"
                    Value="#FF4A4A4A"/>

            <Setter Property="BorderThickness"
                    Value="1.2"/>

            <Setter Property="Padding"
                    Value="50,0,15,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="#FFFF5C9E"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="CampoBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="CampoBorder"
                                        Property="BorderBrush"
                                        Value="#FFFF5C9E"/>

                                <Setter TargetName="CampoBorder"
                                        Property="BorderThickness"
                                        Value="1.6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================= -->
        <!-- PASSWORD BOX -->
        <!-- ========================================= -->

        <Style x:Key="LoginPasswordBoxStyle"
               TargetType="PasswordBox">

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#EE1B1B1B"/>

            <Setter Property="BorderBrush"
                    Value="#FF4A4A4A"/>

            <Setter Property="BorderThickness"
                    Value="1.2"/>

            <Setter Property="Padding"
                    Value="50,0,15,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="#FFFF5C9E"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="PasswordBox">

                        <Border x:Name="CampoBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="CampoBorder"
                                        Property="BorderBrush"
                                        Value="#FFFF5C9E"/>

                                <Setter TargetName="CampoBorder"
                                        Property="BorderThickness"
                                        Value="1.6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================= -->
        <!-- BOTÓN -->
        <!-- ========================================= -->

        <Style x:Key="LoginButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="Foreground"
                    Value="#FF171717"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="9">

                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">

                                    <GradientStop Color="#FFFF58A0"
                                                  Offset="0"/>

                                    <GradientStop Color="#FFFF9FB7"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.93"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.80"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- ========================================= -->
        <!-- FONDO -->
        <!-- ========================================= -->

        <Grid.Background>

            <ImageBrush ImageSource="pack://application:,,,/BlaxtorGym;component/src/BlaxtorGym.WPF/Resources/Images/login.png"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"/>

        </Grid.Background>

        <Border Background="#28000000"/>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================= -->
            <!-- PANEL LOGIN -->
            <!-- ========================================= -->

            <Border Grid.Column="1"
                    Width="505"
                    Padding="48"
                    CornerRadius="24"
                    BorderThickness="1.5"
                    BorderBrush="#FFFF5C9E"
                    Background="#EC101010"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">

                <Border.Effect>

                    <DropShadowEffect Color="#FFFF3E88"
                                      BlurRadius="26"
                                      ShadowDepth="0"
                                      Opacity="0.45"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ================================= -->
                    <!-- PESA -->
                    <!-- ================================= -->

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,18">

                        <Grid Width="170"
                              Height="62">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Height="1"
                                    Margin="0,30,15,0"
                                    Background="#FF555555"
                                    VerticalAlignment="Top"/>

                            <Image Grid.Column="1"
                                   Source="pack://application:,,,/BlaxtorGym;component/src/BlaxtorGym.WPF/Resources/Icons/pesa.png"
                                   Width="58"
                                   Height="58"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Border Grid.Column="2"
                                    Height="1"
                                    Margin="15,30,0,0"
                                    Background="#FF555555"
                                    VerticalAlignment="Top"/>

                        </Grid>

                    </StackPanel>

                    <!-- ================================= -->
                    <!-- TÍTULO -->
                    <!-- ================================= -->

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,38">

                        <TextBlock Text="Bienvenido de nuevo"
                                   Foreground="White"
                                   FontSize="31"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Inicia sesión para continuar"
                                   Foreground="#FFA7A7A7"
                                   FontSize="17"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- ================================= -->
                    <!-- USUARIO -->
                    <!-- ================================= -->

                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,22">

                        <TextBlock Text="USUARIO"
                                   Foreground="{StaticResource RosaPrincipal}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid>

                            <TextBox x:Name="UsuarioTextBox"
                                     Text="{Binding NombreUsuario,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginTextBoxStyle}"/>

                            <Image Source="pack://application:,,,/BlaxtorGym;component/src/BlaxtorGym.WPF/Resources/Icons/usuario.png"
                                   Width="25"
                                   Height="25"
                                   Margin="15,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <TextBlock Text="Ingresa tu usuario"
                                       Foreground="{StaticResource GrisPlaceholder}"
                                       FontSize="16"
                                       Margin="58,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Setter Property="Opacity"
                                                Value="0.85"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Text,
                                                                          ElementName=UsuarioTextBox}"
                                                         Value="">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Text,
                                                                          ElementName=UsuarioTextBox}"
                                                         Value="{x:Null}">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                    </StackPanel>

                    <!-- ================================= -->
                    <!-- CONTRASEÑA -->
                    <!-- ================================= -->

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,32">

                        <TextBlock Text="CONTRASEÑA"
                                   Foreground="{StaticResource RosaPrincipal}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid>

                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource LoginPasswordBoxStyle}"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>

                            <Image Source="pack://application:,,,/BlaxtorGym;component/src/BlaxtorGym.WPF/Resources/Icons/candado.png"
                                   Width="25"
                                   Height="25"
                                   Margin="15,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <TextBlock x:Name="PasswordPlaceholder"
                                       Text="Ingresa tu contraseña"
                                       Foreground="{StaticResource GrisPlaceholder}"
                                       FontSize="16"
                                       Opacity="0.85"
                                       Margin="58,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="Visible"
                                       IsHitTestVisible="False"/>

                        </Grid>

                    </StackPanel>

                    <!-- ================================= -->
                    <!-- BOTÓN LOGIN -->
                    <!-- ================================= -->

                    <Button Grid.Row="4"
                            Content="INICIAR SESIÓN"
                            Style="{StaticResource LoginButtonStyle}"
                            Command="{Binding IniciarSesionCommand}"/>

                    <!-- ================================= -->
                    <!-- PIE -->
                    <!-- ================================= -->

                    <StackPanel Grid.Row="5"
                                Margin="0,28,0,0"
                                HorizontalAlignment="Center">

                        <TextBlock Text="BlaxtorGym"
                                   Foreground="#FF9A9A9A"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="© 2026 - Todos los derechos reservados"
                                   Foreground="#FF777777"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>