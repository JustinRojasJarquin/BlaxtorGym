<UserControl x:Class="BlaxtorGym.src.BlaxtorGym.WPF.Views.ReportesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#FFF7F7F9">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="Reportes" FontSize="28" FontWeight="SemiBold" Foreground="#FF202027"/>
  <Border Grid.Row="1" Margin="0,16,0,12" Padding="14" Background="White" BorderBrush="#FFE2E2E6" BorderThickness="1" CornerRadius="8"><StackPanel>
   <WrapPanel><TextBlock Text="Tipo de reporte" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="190" ItemsSource="{Binding TiposReporte}" SelectedItem="{Binding TipoReporteSeleccionado}" Margin="0,0,18,0"/><TextBlock Text="Fecha inicial" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker SelectedDate="{Binding FechaInicio}" IsEnabled="{Binding MostrarFiltroCliente}" Margin="0,0,12,0"/><TextBlock Text="Fecha final" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker SelectedDate="{Binding FechaFin}" IsEnabled="{Binding MostrarFiltroCliente}"/></WrapPanel>
   <WrapPanel Margin="0,12,0,0"><TextBlock Text="Cliente" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="180" ItemsSource="{Binding Clientes}" DisplayMemberPath="NombreCompleto" SelectedItem="{Binding ClienteSeleccionado}" IsEnabled="{Binding MostrarFiltroCliente}" Margin="0,0,12,0"/><TextBlock Text="Tipo cliente" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="150" ItemsSource="{Binding TiposCliente}" DisplayMemberPath="Nombre" SelectedItem="{Binding TipoClienteSeleccionado}" IsEnabled="{Binding MostrarFiltroTipoCliente}" Margin="0,0,12,0"/><TextBlock Text="Tipo membresía" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="150" ItemsSource="{Binding TiposMembresia}" DisplayMemberPath="Nombre" SelectedItem="{Binding TipoMembresiaSeleccionado}" IsEnabled="{Binding MostrarFiltroTipoMembresia}"/></WrapPanel>
   <WrapPanel Margin="0,12,0,0"><TextBlock Text="Estado" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="130" ItemsSource="{Binding EstadosMembresia}" SelectedItem="{Binding EstadoMembresia}" IsEnabled="{Binding MostrarFiltroEstado}" Margin="0,0,12,0"/><TextBlock Text="Método de pago" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="140" ItemsSource="{Binding MetodosPago}" SelectedItem="{Binding MetodoPago}" IsEnabled="{Binding MostrarFiltroMetodoPago}"/></WrapPanel>
  </StackPanel></Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="GENERAR REPORTE" Command="{Binding GenerarCommand}" Width="155" Height="36" Margin="0,0,10,0"/><Button Content="EXPORTAR PDF" Command="{Binding ExportarPdfCommand}" Width="135" Height="36"/></StackPanel>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="12" Background="White" BorderBrush="#FFE2E2E6" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12"><WrapPanel><TextBlock Text="Clientes: " FontWeight="Bold"/><TextBlock Text="{Binding Resultado.TotalClientes}" Margin="0,0,18,0"/><TextBlock Text="Membresías vigentes: " FontWeight="Bold"/><TextBlock Text="{Binding Resultado.MembresiasVigentes}" Margin="0,0,18,0"/><TextBlock Text="Pagos: " FontWeight="Bold"/><TextBlock Text="{Binding Resultado.TotalPagos}" Margin="0,0,18,0"/><TextBlock Text="Ingresos: " FontWeight="Bold"/><TextBlock Text="{Binding Resultado.TotalIngresos, StringFormat=₡{0:N2}}"/></WrapPanel></Border>
   <TabControl Grid.Row="1"><TabItem Header="Clientes"><DataGrid ItemsSource="{Binding Resultado.Clientes}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}"/><DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}"/><DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}"/><DataGridTextColumn Header="Correo" Binding="{Binding CorreoElectronico}"/><DataGridTextColumn Header="Tipo" Binding="{Binding TipoCliente}"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Membresías"><DataGrid ItemsSource="{Binding Resultado.Membresias}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}"/><DataGridTextColumn Header="Tipo" Binding="{Binding TipoMembresia}"/><DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat={}{0:dd/MM/yyyy}}"/><DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}"/><DataGridTextColumn Header="Precio" Binding="{Binding PrecioAplicado, StringFormat=₡{0:N2}}"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Pagos"><DataGrid ItemsSource="{Binding Resultado.Pagos}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy}}"/><DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}"/><DataGridTextColumn Header="Membresía" Binding="{Binding TipoMembresia}"/><DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=₡{0:N2}}"/><DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}"/><DataGridTextColumn Header="Observación" Binding="{Binding Observacion}"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Mediciones"><ScrollViewer HorizontalScrollBarVisibility="Auto"><DataGrid ItemsSource="{Binding Resultado.Mediciones}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding FechaMedicion, StringFormat={}{0:dd/MM/yyyy}}"/><DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}"/><DataGridTextColumn Header="Peso (kg)" Binding="{Binding PesoKg, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Altura (cm)" Binding="{Binding EstaturaCm, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="IMC" Binding="{Binding Imc, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Grasa (%)" Binding="{Binding PorcentajeGrasa, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Hombros (cm)" Binding="{Binding Hombros, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Pecho (cm)" Binding="{Binding Pecho, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Bíceps D (cm)" Binding="{Binding BicepsDerecho, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Bíceps I (cm)" Binding="{Binding BicepsIzquierdo, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Cintura (cm)" Binding="{Binding Cintura, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Muslo D (cm)" Binding="{Binding MusloDerecho, StringFormat={}{0:N2}}"/><DataGridTextColumn Header="Muslo I (cm)" Binding="{Binding MusloIzquierdo, StringFormat={}{0:N2}}"/></DataGrid.Columns></DataGrid></ScrollViewer></TabItem>
   </TabControl></Grid>
 </Grid>
</UserControl>
