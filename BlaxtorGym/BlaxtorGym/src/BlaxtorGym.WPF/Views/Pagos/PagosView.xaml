<UserControl x:Class="BlaxtorGym.src.BlaxtorGym.WPF.Views.PagosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700"
             MinHeight="500">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gestión de Pagos"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Membresía -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Membresía:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>

                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          ItemsSource="{Binding Membresias}"
                          SelectedItem="{Binding MembresiaSeleccionada}"
                          Margin="0,0,15,10">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding Cliente.NombreCompleto}"/>

                                <TextBlock Text=" - "/>

                                <TextBlock Text="{Binding TipoMembresia.Nombre}"/>

                                <TextBlock Text=" - ₡"/>

                                <TextBlock Text="{Binding PrecioAplicado,
                                                         StringFormat={}{0:N0}}"/>

                            </StackPanel>

                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

                <!-- Monto automático -->
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Monto:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Text="{Binding MontoMostrar}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Método de pago -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Método de pago:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>

                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          ItemsSource="{Binding MetodosPago}"
                          SelectedItem="{Binding MetodoPagoSeleccionado}"
                          Margin="0,0,15,10"/>

                <!-- Fecha -->
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Fecha:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>

                <DatePicker Grid.Row="1"
                            Grid.Column="3"
                            SelectedDate="{Binding FechaPago}"
                            Margin="0,0,0,10"/>

                <!-- Observación -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Observación:"
                           VerticalAlignment="Top"
                           Margin="0,5,10,10"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Height="70"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Observacion,
                                      UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"/>

                <!-- Botones -->
                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Registrar pago"
                            Width="120"
                            Height="32"
                            Margin="5"
                            Command="{Binding RegistrarCommand}"/>

                    <Button Content="Limpiar"
                            Width="90"
                            Height="32"
                            Margin="5"
                            Command="{Binding LimpiarCommand}"/>

                    <Button Content="Filtrar por membresía"
                            Width="150"
                            Height="32"
                            Margin="5"
                            Command="{Binding FiltrarMembresiaCommand}"/>

                    <Button Content="Mostrar todos"
                            Width="110"
                            Height="32"
                            Margin="5"
                            Command="{Binding MostrarTodosCommand}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Historial de pagos -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Pagos}"
                  SelectedItem="{Binding PagoSeleccionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding Membresia.Cliente.NombreCompleto}"
                                    Width="*"/>

                <DataGridTextColumn Header="Membresía"
                                    Binding="{Binding Membresia.TipoMembresia.Nombre}"
                                    Width="130"/>

                <DataGridTextColumn Header="Inicio"
                                    Binding="{Binding Membresia.FechaInicio,
                                                      StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="105"/>

                <DataGridTextColumn Header="Vencimiento"
                                    Binding="{Binding Membresia.FechaVencimiento,
                                                      StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="105"/>

                <DataGridTextColumn Header="Monto"
                                    Binding="{Binding Monto,
                                                      StringFormat={}{0:N0}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Método"
                                    Binding="{Binding MetodoPago}"
                                    Width="120"/>

                <DataGridTextColumn Header="Fecha de pago"
                                    Binding="{Binding FechaPago,
                                                      StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="110"/>

                <DataGridTextColumn Header="Observación"
                                    Binding="{Binding Observacion}"
                                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>