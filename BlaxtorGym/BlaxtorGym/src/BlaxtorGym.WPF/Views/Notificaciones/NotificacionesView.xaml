<UserControl x:Class="BlaxtorGym.src.BlaxtorGym.WPF.Views.NotificacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700"
             MinHeight="500">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Notificaciones de Membresías"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Button Content="Actualizar notificaciones"
                    Width="165"
                    Height="32"
                    Margin="0,0,10,0"
                    Command="{Binding GenerarNotificacionesCommand}"/>

            <Button Content="Mostrar pendientes"
                    Width="140"
                    Height="32"
                    Margin="0,0,10,0"
                    Command="{Binding MostrarPendientesCommand}"/>

            <Button Content="Mostrar todas"
                    Width="120"
                    Height="32"
                    Margin="0,0,10,0"
                    Command="{Binding MostrarTodasCommand}"/>

            <Button Content="Enviar correo"
                    Width="120"
                    Height="32"
                    Command="{Binding EnviarCorreoCommand}"/>

        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Notificaciones}"
                  SelectedItem="{Binding NotificacionSeleccionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="50"/>

                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding Cliente.NombreCompleto}"
                                    Width="170"/>

                <DataGridTextColumn Header="Correo"
                                    Binding="{Binding Cliente.CorreoElectronico}"
                                    Width="180"/>

                <DataGridTextColumn Header="Membresía"
                                    Binding="{Binding Membresia.TipoMembresia.Nombre}"
                                    Width="110"/>

                <DataGridTextColumn Header="Mensaje"
                                    Binding="{Binding Mensaje}"
                                    Width="*"/>

                <DataGridTextColumn Header="Creada"
                                    Binding="{Binding FechaCreacion,
                                                      StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="130"/>

                <DataGridCheckBoxColumn Header="Enviada"
                                        Binding="{Binding Enviada}"
                                        Width="75"/>

                <DataGridTextColumn Header="Fecha envío"
                                    Binding="{Binding FechaEnvio,
                                                      StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="130"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>