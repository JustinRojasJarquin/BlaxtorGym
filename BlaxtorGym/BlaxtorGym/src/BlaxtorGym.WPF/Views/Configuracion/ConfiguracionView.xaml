<UserControl x:Class="BlaxtorGym.src.BlaxtorGym.WPF.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0B0E"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <SolidColorBrush x:Key="RosaPrincipal"
                         Color="#FFFF5C9E"/>

        <SolidColorBrush x:Key="FondoTarjeta"
                         Color="#FF151519"/>

        <SolidColorBrush x:Key="Borde"
                         Color="#FF2D2D34"/>

        <SolidColorBrush x:Key="TextoSecundario"
                         Color="#FF9999A3"/>

        <!-- BOTÓN PRINCIPAL -->

        <Style x:Key="BotonPrincipal"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="MinWidth"
                    Value="200"/>

            <Setter Property="Padding"
                    Value="26,0"/>

            <Setter Property="Foreground"
                    Value="#FF171717"/>

            <Setter Property="Background"
                    Value="{StaticResource RosaPrincipal}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN SECUNDARIO -->

        <Style x:Key="BotonSecundario"
               TargetType="Button">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="MinWidth"
                    Value="170"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="Foreground"
                    Value="#FFE7E7EB"/>

            <Setter Property="Background"
                    Value="#FF202026"/>

            <Setter Property="BorderBrush"
                    Value="#FF383840"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource RosaPrincipal}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.70"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.30"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- RESTAURAR -->

        <Style x:Key="BotonRestaurar"
               TargetType="Button"
               BasedOn="{StaticResource BotonPrincipal}">

            <Setter Property="MinWidth"
                    Value="190"/>

        </Style>

        <!-- DATA GRID -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#FF111114"/>

            <Setter Property="Foreground"
                    Value="#FFECECEF"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#FF29292F"/>

            <Setter Property="RowBackground"
                    Value="#FF151519"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FF19191E"/>

            <Setter Property="RowHeight"
                    Value="48"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="44"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#FF1C1C21"/>

            <Setter Property="Foreground"
                    Value="#FFB9B9C1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="BorderBrush"
                    Value="#FF29292F"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#35FF5C9E"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF202026"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#30FF5C9E"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Margin="32">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- CABECERA -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Copias de seguridad"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Crea, selecciona y restaura copias completas de la información de BlaxtorGym."
                           Foreground="{StaticResource TextoSecundario}"
                           FontSize="14"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="SELECCIONAR RESPALDO"
                        Style="{StaticResource BotonSecundario}"
                        Command="{Binding CargarBackupCommand}"
                        MinWidth="210"
                        Margin="0,0,14,0"/>

                <Button Content="+  CREAR RESPALDO"
                        Style="{StaticResource BotonPrincipal}"
                        Command="{Binding CrearBackupCommand}"
                        MinWidth="205"/>

            </StackPanel>

        </Grid>

        <!-- TARJETAS -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource FondoTarjeta}"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="RESPALDOS CARGADOS"
                               Foreground="{StaticResource TextoSecundario}"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding TotalBackups}"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Disponibles en esta sesión"
                               Foreground="{StaticResource TextoSecundario}"
                               FontSize="12"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource FondoTarjeta}"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="ÚLTIMO RESPALDO"
                               Foreground="{StaticResource TextoSecundario}"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding UltimoBackupTexto}"
                               Foreground="{StaticResource RosaPrincipal}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="{Binding TamanoUltimoBackupTexto}"
                               Foreground="{StaticResource TextoSecundario}"
                               FontSize="12"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource FondoTarjeta}"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="ESTADO DEL SISTEMA"
                               Foreground="{StaticResource TextoSecundario}"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,13,0,0">

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#FF55D68C"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding EstadoTexto}"
                                   Foreground="White"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock Text="Verificación SQLite activa"
                               Foreground="{StaticResource TextoSecundario}"
                               FontSize="12"
                               Margin="18,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- TABLA -->

        <Border Grid.Row="4"
                Background="{StaticResource FondoTarjeta}"
                BorderBrush="{StaticResource Borde}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,17">

                    <StackPanel>

                        <TextBlock Text="Respaldos disponibles"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Selecciona un respaldo de la lista para verificarlo, restaurarlo o eliminarlo."
                                   Foreground="{StaticResource TextoSecundario}"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Backups}"
                          SelectedItem="{Binding BackupSeleccionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AlternationCount="2"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ARCHIVO"
                                            Binding="{Binding NombreArchivo}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="UBICACIÓN"
                                            Binding="{Binding RutaCompleta}"
                                            Width="3*"/>

                        <DataGridTextColumn Header="FECHA"
                                            Binding="{Binding FechaCreacion,
                                                              StringFormat={}{0:dd/MM/yyyy hh:mm tt}}"
                                            Width="185"/>

                        <DataGridTextColumn Header="TAMAÑO"
                                            Binding="{Binding TamanoFormateado}"
                                            Width="110"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- ACCIONES -->

        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="La restauración reemplaza los datos actuales por los contenidos en el respaldo seleccionado."
                           Foreground="{StaticResource TextoSecundario}"
                           FontSize="12"/>

                <TextBlock Text="BlaxtorGym crea una copia de seguridad automática antes de restaurar."
                           Foreground="#FF6F6F78"
                           FontSize="11"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="Verificar integridad"
                        Style="{StaticResource BotonSecundario}"
                        Command="{Binding VerificarCommand}"
                        MinWidth="180"
                        Margin="0,0,14,0"/>

                <Button Content="RESTAURAR RESPALDO"
                        Style="{StaticResource BotonRestaurar}"
                        Command="{Binding RestaurarCommand}"
                        MinWidth="200"
                        Margin="0,0,14,0"/>

                <Button Content="Eliminar respaldo"
                        Style="{StaticResource BotonSecundario}"
                        Command="{Binding EliminarCommand}"
                        MinWidth="175"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>