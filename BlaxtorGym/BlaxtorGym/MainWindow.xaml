<Window x:Class="BlaxtorGym.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlaxtorGym"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="10">

            <TextBlock Text="Módulos"
                       FontSize="18"
                       Margin="0,0,0,15"/>

            <Button Content="Tipos de Cliente"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="TipoCliente_Click"/>

            <Button Content="Clientes"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="Clientes_Click"/>

            <Button Content="Mediciones físicas"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="Mediciones_Click"/>

            <Button Content="Tipos de Membresía"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="TipoMembresia_Click"/>

            <Button Content="Tarifas"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="Tarifas_Click"/>

            <Button Content="Membresías"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="Membresias_Click"/>

            <Button Content="Pagos"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="Pagos_Click"/>

            <Button Content="Notificaciones"
                    Height="35"
                    Click="Notificaciones_Click"/>

        </StackPanel>

        <ContentControl x:Name="ContenidoPrincipal"
                        Grid.Column="1"/>

    </Grid>

</Window>