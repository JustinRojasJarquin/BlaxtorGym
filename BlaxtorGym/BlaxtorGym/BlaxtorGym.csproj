<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="src\BlaxtorGym.WPF\Views\Clientes\" />
    <Folder Include="src\BlaxtorGym.WPF\Views\Mediciones\" />
    <Folder Include="src\BlaxtorGym.WPF\Views\Reportes\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="MahApps.Metro" Version="3.0.0-rc0529" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0-ci1482" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="MimeKit" Version="4.18.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="emailsettings.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="src\BlaxtorGym.WPF\Resources\Images\login.png" />
    <None Remove="src\BlaxtorGym.WPF\Resources\Icons\usuario.png" />
    <None Remove="src\BlaxtorGym.WPF\Resources\Icons\candado.png" />
    <None Remove="src\BlaxtorGym.WPF\Resources\Icons\pesa.png" />

    <Resource Include="src\BlaxtorGym.WPF\Resources\Images\login.png" />
    <Resource Include="src\BlaxtorGym.WPF\Resources\Icons\usuario.png" />
    <Resource Include="src\BlaxtorGym.WPF\Resources\Icons\candado.png" />
    <Resource Include="src\BlaxtorGym.WPF\Resources\Icons\pesa.png" />
  </ItemGroup>

</Project>